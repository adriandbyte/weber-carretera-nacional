{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "generate": {
      // Prisma escribe el cliente dentro de node_modules, fuera de cualquier
      // carpeta que turbo pueda declarar como salida. Cachear la tarea dejaria
      // el cliente viejo en su sitio.
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "BLOB_READ_WRITE_TOKEN",
        "ADMIN_PASSWORD",
        "NEXT_PUBLIC_*",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      // Sin dependencias: ningun paquete compila a dist, las dos apps consumen
      // core y db como fuente TypeScript. Encadenarlo a ^build solo serializaba
      // lo que puede correr en paralelo.
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.mjs"]
    },
    "typecheck": {
      // Esto si necesita el cliente de Prisma generado: sin el no existen los
      // tipos de @weber/db y tsc falla con cientos de errores enganosos.
      //
      // Van los dos y no solo "^generate": el acento circunflejo significa "el
      // generate de mis dependencias", y @weber/db no depende de ningun paquete
      // que genere nada, asi que su propio typecheck no esperaba a su propio
      // generate. En local nunca se noto porque siempre habia un cliente de
      // antes; en un checkout limpio las dos tareas corrian en paralelo y tsc
      // perdia la carrera.
      "dependsOn": ["^generate", "generate"]
    }
  }
}
