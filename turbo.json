{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "generate": {
      // Desde Prisma 7 el cliente se escribe en una carpeta del paquete y no
      // dentro de node_modules, asi que ya se puede declarar como salida y
      // cachear. Antes no: la tarea corria entera en cada arranque porque su
      // resultado quedaba donde turbo no lo veia.
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "BLOB_READ_WRITE_TOKEN",
        "ADMIN_PASSWORD",
        "NEXT_PUBLIC_*",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      // Sin dependencias: ningun paquete compila a dist, las dos apps consumen
      // core y db como fuente TypeScript. Encadenarlo a ^build solo serializaba
      // lo que puede correr en paralelo.
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.mjs"]
    },
    "typecheck": {
      // Esto si necesita el cliente de Prisma generado: sin el no existen los
      // tipos de @weber/db y tsc falla con cientos de errores enganosos.
      "dependsOn": ["^generate"]
    },
    "test": {
      "dependsOn": ["^generate"],
      // Las pruebas consultan la base de datos real (que no haya URLs
      // duplicadas, que el uso de cada catalogo cuadre). Su resultado depende
      // de datos que turbo no puede ver, asi que un acierto de cache seria una
      // prueba que en realidad no se ejecuto.
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_URL"]
    }
  }
}
