# Un solo .env, en la raiz. Cada app y packages/db lo alcanzan por symlink: no
# crees uno por paquete. Y nada lo carga solo fuera de Next, por eso
# packages/db empieza con `import 'dotenv/config'`.
#
# Copialo como .env y cambia los valores. Los de aqui son de mentira.

# --- Postgres --------------------------------------------------------------
#
# Son dos porque hacen cosas distintas, y en un despliegue no pueden ser la
# misma cadena:
#
#   DATABASE_URL   la que consultan las apps y los scripts. Puede ir por un
#                  pooler, y conviene que vaya.
#   DIRECT_URL     la conexion directa. La usa el CLI de Prisma para migrar,
#                  que manda ordenes DDL, y esas un pooler no las admite. Si
#                  aqui pones la del pooler, `pnpm db:migrate` falla con un
#                  error que no menciona el pooler.
#
# En produccion DIRECT_URL solo vive en la maquina que migra: al panel no le
# hace falta.
#
# sslmode=verify-full y no sslmode=require: `pg` avisa que en su proxima
# version mayor `require` va a dejar de verificar el certificado, asi que se
# escribe el modo seguro a proposito y de paso se calla el aviso.
DATABASE_URL="postgresql://weber:contrasena@ep-ejemplo-12345678-pooler.us-east-1.aws.neon.tech/weber?sslmode=verify-full"
DIRECT_URL="postgresql://weber:contrasena@ep-ejemplo-12345678.us-east-1.aws.neon.tech/weber?sslmode=verify-full"

# En local suelen ser la misma, contra el contenedor de Docker:
# DATABASE_URL="postgresql://weber:weber@localhost:55432/weber?schema=public"
# DIRECT_URL="postgresql://weber:weber@localhost:55432/weber?schema=public"

# --- Imagenes --------------------------------------------------------------
#
# Sin este token las imagenes se guardan en data/imagenes del disco que
# importo, y en un despliegue esas URLs no resuelven. El store tiene que ser
# **publico**: el modo de acceso se elige al crearlo y no se puede cambiar
# despues, y con uno privado la importacion se cae en la primera foto.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_EjemploDeStore123_abcdefghijklmnopqrstuvwx"

# --- Tienda publica --------------------------------------------------------
#
# La usan el sitemap, el robots.txt y las URLs canonicas, y las tres tienen
# que anunciar el mismo dominio. Si se deja vacia, en Vercel se toma
# VERCEL_PROJECT_PRODUCTION_URL, asi que las vistas previa apuntan al dominio
# de produccion en lugar de indexarse solas.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Panel de administracion -----------------------------------------------
#
# Contraseña compartida por HTTP Basic. El usuario se ignora, solo cuenta la
# clave. Vacia en local para trabajar sin estorbo; en cualquier despliegue es
# obligatoria, y sin ella el panel responde 503 en lugar de quedar abierto.
ADMIN_PASSWORD=""
